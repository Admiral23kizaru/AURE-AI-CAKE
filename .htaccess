Options -Indexes
RewriteEngine On


# Deployment metadata and repository internals must never be public.
RewriteRule ^(?:\.git|\.cursor|\.qodo)(?:/|$) - [F,L,NC]
# Internal services, migrations, logs, and retired project copies are never web endpoints.
RewriteRule ^(?:inc|cli|migrations|logs|webhooks|PHPMailer|backup_paymongo|Cake[\x20%]Shop[\x20%]2026|frontend-backup-[^/]+)(?:/|$) - [F,L,NC]

<FilesMatch "^(\.env|config\.php|config\.production\.php|migrate(_002)?\.php|sms_test\.php|test_email\.php|default\.php|ai_gcash_payment\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|zip|log)$">
  Require all denied
</FilesMatch>
